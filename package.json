{
  "name": "ts-mongodb-autoembed",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file=.env.local ./node_modules/vite/bin/vite.js dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "create-index": "tsx --env-file=.env.local scripts/create-index.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "setup-atlas": "tsx --env-file=.env.local scripts/setup-atlas.ts",
    "stack:up": "./scripts/stack-up.sh",
    "stack:down": "./scripts/stack-down.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "latest",
